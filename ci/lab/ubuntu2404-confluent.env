LAB_NAME=jenkins-ubuntu2404-confluent-${BUILD_NUMBER}

DISTRO_ID=ubuntu
DISTRO_VERSION=24.04
DISTRO_MAJOR=24
PROVISIONER=confluent

BASE_IMAGE=/var/lib/libvirt/images/noble-server-cloudimg-amd64.img
CLUSTER_ISO=/var/lib/libvirt/images/ubuntu-24.04.4-live-server-amd64.iso

OPENCATTUS_SOURCE_DIR=${WORKSPACE}
IMAGE_ROOT=/var/lib/libvirt/images/opencattus-lab

HEADNODE_MEMORY_MB=24576
HEADNODE_VCPUS=8
HEADNODE_DISK_GB=220

COMPUTE_COUNT=4
COMPUTE_MEMORY_MB=8192
COMPUTE_VCPUS=2

NODE_SOCKETS=1
NODE_CORES_PER_SOCKET=2
NODE_THREADS_PER_CORE=1
NODE_CPUS_PER_NODE=2
NODE_REAL_MEMORY_MB=4096

MPI_SMOKE_NODES=4
MPI_SMOKE_TASKS=4
REMOTE_BUILD_JOBS=4

CLUSTER_NAME=opencattus
CLUSTER_HOSTNAME=opencattus
CLUSTER_DOMAIN=cluster.example.com
TIMEZONE=UTC
TIMESERVER=pool.ntp.org
LOCALE=en_US.utf8

COMPUTE_BOOT_MODES="bios uefi bios uefi"
COMPUTE_PROVISION_TYPES="stateless stateless stateful stateful"

# Lane-isolated subnets: the six lab lanes run in parallel across two lab
# hosts, so every lane needs its own external and management networks
# (harness defaults collide). Gateway overrides also require matching
# DHCP range and headnode/host IPs.
EXTERNAL_GATEWAY_IP=192.168.115.1
EXTERNAL_DHCP_START=192.168.115.100
EXTERNAL_DHCP_END=192.168.115.199
EXTERNAL_HEADNODE_IP=192.168.115.10
MANAGEMENT_GATEWAY_IP=192.168.35.254
MANAGEMENT_HOST_IP=192.168.35.253
